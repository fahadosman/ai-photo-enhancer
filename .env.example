# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ai_photo_enhancer"

# Next Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_JWT_SECRET="your-jwt-secret-here"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Paddle Billing
PADDLE_API_KEY="paddle_api_key_here"
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="paddle_client_token_here"
PADDLE_WEBHOOK_SECRET_KEY="paddle_webhook_secret_here"
NEXT_PUBLIC_PADDLE_ENVIRONMENT="sandbox"

# Replicate AI
REPLICATE_API_TOKEN="r8_your_replicate_token_here"
REPLICATE_MODEL_VERSION="your_replicate_model_version"
ENHANCE_WEBHOOK_SECRET="random_webhook_secret"

# Cloudinary
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AI Photo Enhancer"
